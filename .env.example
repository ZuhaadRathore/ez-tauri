# ------------------------------------------------------------------------------
# Environment Variables
#
# This file contains the environment variables needed for the application.
# Copy this file to .env for local development and replace the placeholder
# values with your actual credentials.
# ------------------------------------------------------------------------------

# Database Configuration
# On first run, this URL will be securely stored in Stronghold.
# After the first run, this value is no longer used.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://user:password@localhost:5432/ez_tauri

# Redis Configuration
# Connection URL for the Redis server.
# Format: redis://<host>:<port>
REDIS_URL=redis://localhost:6379

# Application Configuration
# The current environment (e.g., development, production).
APP_ENV=development

# JWT Authentication Configuration
# ⚠️ CRITICAL: JWT_SECRET is REQUIRED and must be at least 32 characters!
# The application will fail to start if this is not set properly.
# Generate a secure secret with: openssl rand -base64 32
# DO NOT use the placeholder value below - generate your own!
JWT_SECRET=your-secret-key-here-change-in-production-min-32-chars-use-openssl-rand
# Access token expiration in hours (default: 1 for security, refresh tokens handle re-auth)
JWT_ACCESS_TOKEN_HOURS=1
# Refresh token expiration in days (default: 30)
JWT_REFRESH_TOKEN_DAYS=30

# Logging Configuration
# The minimum log level to output (error, warn, info, debug, trace).
LOG_LEVEL=info
# Enable or disable console logging.
LOG_CONSOLE_ENABLED=true
# The format for console logs (pretty, compact, full, json).
LOG_CONSOLE_FORMAT=pretty
# Use ANSI colors in console output.
LOG_CONSOLE_COLORS=true
# Enable or disable file logging.
LOG_FILE_ENABLED=true
# The file name prefix for rotated logs.
LOG_FILE_PREFIX=ez-tauri
# Force JSON output for all logs.
LOG_JSON=false
# The directory to store log files.
LOG_DIRECTORY=logs
# The rotation frequency for log files (never, minutely, hourly, daily, weekly).
LOG_ROTATION=daily
# The number of log files to keep.
LOG_MAX_FILES=30
# The maximum size of each log file in megabytes.
LOG_MAX_SIZE_MB=100
